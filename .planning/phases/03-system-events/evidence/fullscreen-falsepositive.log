RUN=4 FIRST_HOLDS=holds=(none) LAST_HOLDS=holds=(none) PAUSED_TICKS=0 PLAYING_TICKS=5
RUN=5 FIRST_HOLDS=holds=(none) LAST_HOLDS=holds=(none) PAUSED_TICKS=0 PLAYING_TICKS=5
